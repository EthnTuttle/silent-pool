+    ///
+    /// - A profile selects its own package dialect (its whole point), so
+    ///   `RBITCOIN_RPC_PACKAGE_DIALECT=0` (explicit off) plus a profile is a
+    ///   config error.
+    /// - An unset or on dialect env just ORs in, preserving the existing
+    ///   behavior for the dialect alone.
+    /// - CLI and env name the same small set of profiles, so both parse or
+    ///   both fail; they cannot disagree on *which* profile. A second
+    ///   profile would need an explicit conflict rule here.
+    pub fn resolve_rpc_env(&mut self, env: &NodeEnv) -> Result<(), NodeError> {
+        if let Some(profile) = self.rpc.compat_profile.or(env.rpc_compat_profile) {
+            self.rpc.compat_profile = Some(profile);
