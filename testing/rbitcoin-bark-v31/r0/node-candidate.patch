+/// `RBITCOIN_RPC_COMPAT_PROFILE`. Any value other than the one accepted
+/// profile name is an error; there is no free-form version knob.
+fn env_profile(
+    (key, val): (&str, Option<OsString>),
+) -> Result<Option<rbitcoin_rpc::methods::RpcCompatProfile>, NodeError> {
+    env_value(key, val.as_deref())?
+        .map(|v| {
+            rbitcoin_rpc::methods::RpcCompatProfile::parse(v)
+                .map_err(|e| NodeError::Config(format!("{key}: {e}")))
+        })
+        .transpose()
